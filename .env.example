# Copy values into Railway service variables. Never commit real credentials.
WORDPRESS_DB_HOST=${{MySQL.MYSQLHOST}}:${{MySQL.MYSQLPORT}}
WORDPRESS_DB_USER=${{MySQL.MYSQLUSER}}
WORDPRESS_DB_PASSWORD=${{MySQL.MYSQLPASSWORD}}
WORDPRESS_DB_NAME=${{MySQL.MYSQLDATABASE}}
WORDPRESS_TABLE_PREFIX=wp_
WP_HOME=https://${{RAILWAY_PUBLIC_DOMAIN}}
WP_SITEURL=https://${{RAILWAY_PUBLIC_DOMAIN}}
WP_MEMORY_LIMIT=256M
WP_MAX_MEMORY_LIMIT=512M
SA_NAME=Supreme Autoparts
SA_TAGLINE=Parts that fit. Built to perform.
SA_PHONE=1-800-555-PART
SA_EMAIL=support@supremeautoparts.com
SA_HOURS=Mon-Fri, 9am-6pm PT
SA_FREE_SHIP=99

# Generate unique salts at https://api.wordpress.org/secret-key/1.1/salt/
WORDPRESS_AUTH_KEY=replace-with-random-value
WORDPRESS_SECURE_AUTH_KEY=replace-with-random-value
WORDPRESS_LOGGED_IN_KEY=replace-with-random-value
WORDPRESS_NONCE_KEY=replace-with-random-value
WORDPRESS_AUTH_SALT=replace-with-random-value
WORDPRESS_SECURE_AUTH_SALT=replace-with-random-value
WORDPRESS_LOGGED_IN_SALT=replace-with-random-value
WORDPRESS_NONCE_SALT=replace-with-random-value
